{
  // The game now ships as plain ES modules in web/js - this config exists only
  // for editor IntelliSense and for `npm run convert`, which re-emits web/js
  // from the TypeScript kept in src_web/src for reference.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "useDefineForClassFields": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["web/js", "src_web/src", "tools"]
}
