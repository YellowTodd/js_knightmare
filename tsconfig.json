{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "useDefineForClassFields": true,
    "skipLibCheck": true,
    // "node" is needed by vite.config.ts (node:fs / node:path / node:url) and
    // by Vite's own plugin types. The game code under src_web/src stays
    // browser-only in practice - it uses no Node globals.
    "types": ["vite/client", "node"]
  },
  "include": ["src_web/src", "vite.config.ts"]
}
